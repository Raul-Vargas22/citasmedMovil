<?xml version="1.0" encoding="utf-8"?>
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:background="#F2F7FA">
        <include layout="@layout/cm_cabecera_empleado" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="18dp" android:orientation="vertical">
                <TextView android:id="@+id/btnRegresarEmpleado" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="← Regresar" android:textSize="14sp"
                    android:textColor="#3489B8" android:paddingBottom="14dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Gestión de citas" android:textColor="#263F4F" android:textSize="25sp"
                    android:textStyle="bold" />
                <Button android:id="@+id/btnRegistrarCitaEmpleado" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="+ Registrar cita" android:textAllCaps="false" android:textColor="#FFFFFF" android:background="@drawable/cm_boton"/>
                <EditText android:id="@+id/txtBuscarCitaEmpleado" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:paddingStart="12dp" android:hint="Buscar por paciente o médico" android:singleLine="true" android:inputType="text" android:background="@drawable/cm_campo"/>
                <TextView android:id="@+id/txtEstadoCitasEmpleado" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:text="Cargando información..." android:textColor="#678396" />
                <LinearLayout android:id="@+id/contenedorCitasEmpleado" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
        <include layout="@layout/cm_barra_empleado" />
    </LinearLayout>