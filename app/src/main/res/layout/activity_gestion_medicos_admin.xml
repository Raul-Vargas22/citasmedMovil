<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F7FA"
    tools:context=".vista.gestion_medicos_admin">

    <include layout="@layout/cm_cabecera_empleado" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="19dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="20dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnRegresarAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="43dp"
                android:paddingBottom="14dp"
                android:text="← Regresar"
                android:textColor="#398AB6"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textView10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Gestion de medicos"
                android:textColor="#263F4F"
                android:textSize="26sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRegistrarMedicoAdmin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Registrar medico" />

            <EditText
                android:id="@+id/txtBuscarMedicoEspec"
                android:layout_width="match_parent"
                android:layout_height="49dp"
                android:layout_marginTop="19dp"
                android:background="@drawable/cm_campo"
                android:hint="Buscar medico o especialidad"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="#263F4F"
                android:textColorHint="#90A1AE"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/cm_tarjeta_alt"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:id="@+id/tarjetaMedicoAdmin1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="45dp"
                        android:background="@drawable/cm_icono"
                        android:gravity="center"
                        android:text="⚕"
                        android:textColor="#438FC1"
                        android:textSize="22sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Dra. Elena Ramírez"
                            android:textColor="#263F4F"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textView28"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Medicina general"
                            android:textColor="#7E91A1"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Lun a Vie · 9:00–14:00"
                            android:textColor="#277DB1"
                            android:textSize="11sp" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/cm_tarjeta_alt"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:id="@+id/tarjetaMedicoAdmin2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textView25"
                        android:layout_width="42dp"
                        android:layout_height="45dp"
                        android:background="@drawable/cm_icono"
                        android:gravity="center"
                        android:text="⚕"
                        android:textColor="#438FC1"
                        android:textSize="22sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textView30"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Dr. Luis Méndez"
                            android:textColor="#263F4F"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textView32"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Cardiología"
                            android:textColor="#7E91A1"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/textView33"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Lun a Vie · 9:00–14:00"
                            android:textColor="#277DB1"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/cm_tarjeta_alt"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:id="@+id/tarjetaMedicoAdmin3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textView26"
                        android:layout_width="42dp"
                        android:layout_height="45dp"
                        android:background="@drawable/cm_icono"
                        android:gravity="center"
                        android:text="⚕"
                        android:textColor="#438FC1"
                        android:textSize="22sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textView36"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Dr. Carlos Sánchez"
                            android:textColor="#263F4F"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textView37"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Pediatría"
                            android:textColor="#7E91A1"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/textView38"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Lun a Vie · 9:00–14:00"
                            android:textColor="#277DB1"
                            android:textSize="11sp" />

                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>