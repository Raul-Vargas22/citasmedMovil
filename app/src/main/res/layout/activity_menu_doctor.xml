<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF4FA"
    tools:context=".vista.menuDoctor">

    <ScrollView
        android:id="@+id/scrollDoctor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/barraNavegacion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="7dp"
                android:paddingBottom="9dp">

                <TextView
                    android:id="@+id/txtTituloAplicacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Médico · Aplicación móvil"
                    android:textColor="#304F62"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/txtDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Consulta de agenda e información necesaria del&#10;paciente."
                    android:textColor="#8194A1"
                    android:textSize="10sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="39dp"
                    android:background="#F8FBFD"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <TextView
                        android:id="@+id/txtInicio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Inicio"
                        android:textColor="#304F62"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/txtPerfilSuperior"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Médico · Móvil"
                        android:textColor="#8998A3"
                        android:textSize="9sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:background="#FFFFFF">

                    <TextView
                        android:id="@+id/btnSalir"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↪ Salir"
                        android:textColor="#557789"
                        android:textSize="9sp" />

                    <ImageView
                        android:id="@+id/imgLogoDoctor"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="7dp"
                        android:src="@drawable/captura_de_pantalla_2026_07_07_224942"
                        android:scaleType="fitCenter"
                        android:contentDescription="Logo CITASMED" />

                    <TextView
                        android:id="@+id/txtCitasmed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="CITASMED"
                        android:textColor="#416579"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/txtIniciales"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:gravity="center"
                        android:text="AL"
                        android:textColor="#50809A"
                        android:textSize="8sp"
                        android:background="@drawable/cm_circulo_usuario" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#F4F9FC"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:paddingTop="17dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:id="@+id/txtPanelMedico"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PANEL DE MÉDICO"
                        android:letterSpacing="0.12"
                        android:textColor="#438CAC"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtAgendaMedica"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Agenda médica"
                        android:textColor="#304F62"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Funciones disponibles de acuerdo con el tipo de usuario."
                        android:textColor="#8294A0"
                        android:textSize="9sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/cardCitas"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/cm_tarjeta_estadistica"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp">

                            <TextView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:gravity="center"
                                android:text="▣"
                                android:textColor="#5790AB"
                                android:textSize="13sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txtCitasActivas"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="8"
                                    android:textColor="#304F62"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Citas activas"
                                    android:textColor="#8999A4"
                                    android:textSize="7sp" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/cardMedicos"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_marginTop="7dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/cm_tarjeta_estadistica"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp">

                            <TextView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:gravity="center"
                                android:text="▣"
                                android:textColor="#5790AB"
                                android:textSize="13sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txtMedicosRegistrados"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="4"
                                    android:textColor="#304F62"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Médicos registrados"
                                    android:textColor="#8999A4"
                                    android:textSize="7sp" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/cardEspecialidades"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_marginTop="7dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/cm_tarjeta_estadistica"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp">

                            <TextView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:gravity="center"
                                android:text="▣"
                                android:textColor="#5790AB"
                                android:textSize="13sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txtEspecialidades"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="4"
                                    android:textColor="#304F62"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Especialidades"
                                    android:textColor="#8999A4"
                                    android:textSize="7sp" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="Funciones disponibles"
                        android:textColor="#304F62"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:id="@+id/btnCitasAsignadas"
                        android:layout_width="match_parent"
                        android:layout_height="37dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/cm_opcion_menu"
                        android:paddingStart="9dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:layout_width="25dp"
                            android:layout_height="wrap_content"
                            android:text="▣"
                            android:textColor="#5C91AA"
                            android:textSize="11sp"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Citas asignadas"
                            android:textColor="#557789"
                            android:textSize="8sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#6B94A8"
                            android:textSize="17sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnDatosPaciente"
                        android:layout_width="match_parent"
                        android:layout_height="37dp"
                        android:layout_marginTop="7dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/cm_opcion_menu"
                        android:paddingStart="9dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:layout_width="25dp"
                            android:layout_height="wrap_content"
                            android:text="♧"
                            android:textColor="#5C91AA"
                            android:textSize="13sp"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Datos del paciente"
                            android:textColor="#557789"
                            android:textSize="8sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#6B94A8"
                            android:textSize="17sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnHorario"
                        android:layout_width="match_parent"
                        android:layout_height="37dp"
                        android:layout_marginTop="7dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/cm_opcion_menu"
                        android:paddingStart="9dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:layout_width="25dp"
                            android:layout_height="wrap_content"
                            android:text="◷"
                            android:textColor="#5C91AA"
                            android:textSize="13sp"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Horario"
                            android:textColor="#557789"
                            android:textSize="8sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#6B94A8"
                            android:textSize="17sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/barraNavegacion"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="19dp"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textColor="#4D91AE"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicio"
                android:textColor="#4D91AE"
                android:textSize="7sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCitas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="29dp"
                android:layout_height="wrap_content"
                android:text="▣"
                android:textColor="#8999A4"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Citas asignadas"
                android:textColor="#8999A4"
                android:textSize="7sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navDatos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♧"
                android:textColor="#8999A4"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Datos del paciente"
                android:textColor="#8999A4"
                android:textSize="7sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navHorario"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◷"
                android:textColor="#8999A4"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Horario"
                android:textColor="#8999A4"
                android:textSize="7sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>