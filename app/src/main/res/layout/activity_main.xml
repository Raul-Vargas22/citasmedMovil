<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF4FA">
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="18dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/cm_tarjeta"
                android:elevation="3dp"
                android:paddingStart="23dp"
                android:paddingEnd="23dp"
                android:paddingTop="27dp"
                android:paddingBottom="26dp">
                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:src="@drawable/logo"
                    android:contentDescription="Logotipo CITASMED"
                    android:scaleType="fitCenter" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="CITASMED"
                    android:textColor="#2A536D"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="ACCESO AL SISTEMA"
                    android:letterSpacing="0.10"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    android:textColor="#438CAC" />
                <TextView
                    android:id="@+id/txtTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Iniciar sesión"
                    android:textColor="#243E4C"
                    android:textSize="27sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center"
                    android:text="Ingresa con el perfil correspondiente."
                    android:textSize="12sp"
                    android:textColor="#7D8E9A" />
                <TextView
                    android:id="@+id/txtPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Tipo de usuario"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="#263F4F" />
                <Spinner
                    android:id="@+id/opcPerfiles"
                    android:layout_width="match_parent"
                    android:layout_height="47dp"
                    android:layout_marginTop="7dp"
                    android:spinnerMode="dialog"
                    android:entries="@array/perfiles"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="Correo electrónico"
                    android:textColor="#263F4F"
                    android:textStyle="bold"
                    android:textSize="12sp" />
                <EditText
                    android:id="@+id/txtUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="47dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/cm_campo"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:hint="usuario@citasmed.mx"
                    android:inputType="textEmailAddress"
                    android:singleLine="true"
                    android:textColor="#263F4F"
                    android:textColorHint="#92A3AE"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="Contraseña"
                    android:textStyle="bold"
                    android:textColor="#263F4F"
                    android:textSize="12sp" />
                <EditText
                    android:id="@+id/txtContra"
                    android:layout_width="match_parent"
                    android:layout_height="47dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/cm_campo"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:hint="••••••••"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:textColor="#263F4F"
                    android:textColorHint="#92A3AE"
                    android:textSize="14sp" />
                <Button
                    android:id="@+id/btnInicioSesion"
                    android:layout_width="match_parent"
                    android:layout_height="49dp"
                    android:layout_marginTop="17dp"
                    android:background="@drawable/cm_boton"
                    android:backgroundTint="@null"
                    android:text="Ingresar"
                    android:textColor="#FFFFFF"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="¿No tienes una cuenta? Crear cuenta"
                    android:textSize="12sp"
                    android:textColor="#6B869A" />
                <Button
                    android:id="@+id/btnSalir"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:visibility="gone"
                    android:text="Salir de la aplicación" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
