<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="#FFFFFF"
    android:elevation="8dp">

    <LinearLayout
        android:id="@+id/navInicioPaciente"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:minHeight="48dp"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground">

        <TextView
            android:id="@+id/navInicioIcono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⌂"
            android:textSize="25sp"
            android:textColor="#777777" />

        <TextView
            android:id="@+id/navInicioTexto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inicio"
            android:textSize="13sp"
            android:textColor="#777777" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/navNuevaCitaPaciente"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:minHeight="48dp"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground">

        <TextView
            android:id="@+id/navNuevaCitaIcono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▦"
            android:textSize="25sp"
            android:textColor="#777777" />

        <TextView
            android:id="@+id/navNuevaCitaTexto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nueva cita"
            android:textSize="13sp"
            android:textColor="#777777" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/navMisCitasPaciente"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:minHeight="48dp"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground">

        <TextView
            android:id="@+id/navMisCitasIcono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▦"
            android:textSize="25sp"
            android:textColor="#777777" />

        <TextView
            android:id="@+id/navMisCitasTexto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mis citas"
            android:textSize="13sp"
            android:textColor="#777777" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/navMedicosPaciente"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:minHeight="48dp"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground">

        <TextView
            android:id="@+id/navMedicosIcono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚕"
            android:textSize="25sp"
            android:textColor="#777777" />

        <TextView
            android:id="@+id/navMedicosTexto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Médicos"
            android:textSize="13sp"
            android:textColor="#777777" />

    </LinearLayout>

</LinearLayout>
